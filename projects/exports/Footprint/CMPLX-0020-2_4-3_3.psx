# Allegro Script
# File: F:\Cadence_learn\FPX\Footprint\CMPLX-0020-2_4-3_3.psx
version 24.1

new
newdrawfillin "CMPLX-0020-2_4-3_3.dra" "Shape Symbol"
setwindow pcb

# Drawing Parameters
QtSignal SPBDesignInitPrompt spbdip_ok_button clicked

prmed
setwindow Form.prmedit
FORM prmedit design
FORM prmedit units Millimeter
FORM prmedit accuracy 4
FORM prmedit size Other
FORM prmedit x -10
FORM prmedit y -10
FORM prmedit width 20
FORM prmedit height 20
FORM prmedit x -10
FORM prmedit y -10
FORM prmedit done
setwindow pcb

# Graphics
shape add
setwindow Form.mini
FORM mini class PACKAGE GEOMETRY
FORM mini subclass
FORM mini dyns_fill_type Static solid
FORM mini dyns_grid None
FORM mini dyns_lock_mode Line
setwindow pcb
pick -1.2 -1.65
pick -1.2 1.45
pick -1 1.65
pick 1.2 1.65
pick 1.2 -1.65
pick -1.2 -1.65
done

zoom fit
save_as
fillin "cmplx-0020-2_4-3_3.dra"
create symbol
fillin "cmplx-0020-2_4-3_3.ssm"
fillin yes
exit
fillin yes

# end
