unset addline_nomerge

# Attributes
setwindow pcb
package_height
pick grid 0 0
setwindow Form.mini
FORM mini height_max 1.7mm
setwindow pcb
done

define property
setwindow Form.dpr_select
FORM dpr_select name DESCRIPTION
setwindow Form.dpr_define
FORM dpr_define shapes_elem YES
FORM dpr_define symbols_elem YES
FORM dpr_define data_type STRING
FORM dpr_define apply
setwindow Form.dpr_select
FORM dpr_select done

property edit
setwindow Form.find
FORM find name_type Drawing
FORM find find_by_name
setwindow Form.findname
FORM findname objlist 'Drawing Select'
FORM findname done
setwindow Form.editprop1
FORM editprop1 properties Description
setwindow Form.editprop2
FORM editprop2 Description ele_prop_value "Small Outline IC (SOIC) with tab, 1.27 mm pitch; 9 pin, 4.90 mm L X 3.90 mm W X 1.70 mm H body"
setwindow Form.editprop1
FORM editprop1 done

# Labels
Label refdes
setwindow Form.mini
FORM mini text_block 6
FORM mini angle 0
FORM mini mirror NO
FORM mini text_justification Center
FORM mini class REF DES
FORM mini subclass ASSEMBLY_TOP
setwindow pcb
pick 0 -1
Text "REF"
done
setwindow pcb

Label refdes
setwindow Form.mini
FORM mini text_block 3
FORM mini angle 0
FORM mini mirror NO
FORM mini text_justification Center
FORM mini class REF DES
FORM mini subclass SILKSCREEN_TOP
setwindow pcb
pick 0 -0.6
Text "REF"
done
setwindow pcb

# 3D STEP Model Placement
setwindow pcb
generaledit
scriptmode +e
setwindow pcb
generaledit
3DX
setwindow PropPane
generaledit
QtSignal Allegro3DWindow Allegro3DWindow activate
QtSignal PropertyStatusWidget 3d_model_import clicked
QtFillin filesystem "ESOP-8.step" "ESOP-8.step"
updateport SearchPane
updateport PropPane
QtSignal algro3dGlobal algro3dDispatch flush
QtSignal Allegro3DWindow Allegro3DWindow deactivate
setwindow pcb

zoom fit
save
exit
# END
