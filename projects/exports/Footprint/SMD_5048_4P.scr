# Allegro Script
# File: F:\Cadence_learn\FPX\Footprint\SMD_5048_4P.scr
version 24.1

setwindow pcb
new
newdrawfillin "SMD_5048_4P.dra" "Package Symbol"

Color
setwindow Form.cvf_main
FORM cvf_main class_list Components
FORM cvf_main all_visible1 YES
FORM cvf_main all_visible2 YES
FORM cvf_main all_visible3 YES
FORM cvf_main class_list Geometry
FORM cvf_main all_visible5 YES
FORM cvf_main package_geometry/pin_number/visible NO
FORM cvf_main class_list Stack-Up
FORM cvf_main all_visible1 YES
FORM cvf_main ok

# Drawing Parameters
QtSignal SPBDesignInitPrompt spbdip_ok_button clicked

generaledit
prmed
setwindow Form.prmedit
FORM prmedit design
FORM prmedit units Millimeter
FORM prmedit accuracy 4
FORM prmedit size Other
FORM prmedit width 18.4
FORM prmedit height 15.4
FORM prmedit Apply
FORM prmedit x -9.5
FORM prmedit y -7.7
FORM prmedit done
setwindow pcb

# define subclass
define subclass
setwindow Form.subclass
FORM subclass package_geometry pick
setwindow Form.subclass_nonetch
FORM subclass_nonetch name 
setwindow Form.subclass
FORM subclass done
setwindow pcb

# Pin Generation
add pin
setwindow Form.mini
Form mini rect_or_polar Rectangular
Form mini x_count 1
Form mini y_count 1
Form mini rotate_pin 0.0
FORM mini pad_name r194_134
FORM mini next_pin_number 1
rotate
iangle 180
FORM mini pintype_mechanical NO
FORM mini offsetx 0
FORM mini offsety 0
setwindow pcb
pick -2.6 1.582
pick -2.6 -1.582
setwindow Form.mini
iangle -180
setwindow pcb
pick 2.6 -1.582
pick 2.6 1.582
done

# Graphics
set addline_nomerge

add line
setwindow Form.mini
FORM mini lock_direction Off
FORM mini class PACKAGE GEOMETRY
FORM mini subclass DISPLAY_TOP
FORM mini line_width 0.025
setwindow pcb
pick 1.7 1
pick 1.7 2.2
pick 3.5 2.2
pick 3.5 1
pick 1.7 1
done

add line
setwindow Form.mini
FORM mini lock_direction Off
FORM mini class PACKAGE GEOMETRY
FORM mini subclass DISPLAY_TOP
FORM mini line_width 0.025
setwindow pcb
pick 1.7 -2.2
pick 1.7 -1
pick 3.5 -1
pick 3.5 -2.2
pick 1.7 -2.2
done

add line
setwindow Form.mini
FORM mini lock_direction Off
FORM mini class PACKAGE GEOMETRY
FORM mini subclass DISPLAY_TOP
FORM mini line_width 0.025
setwindow pcb
pick -1.7 -1
pick -1.7 -2.2
pick -3.5 -2.2
pick -3.5 -1
pick -1.7 -1
done

add line
setwindow Form.mini
FORM mini lock_direction Off
FORM mini class PACKAGE GEOMETRY
FORM mini subclass DISPLAY_TOP
FORM mini line_width 0.025
setwindow pcb
pick -1.7 2.2
pick -1.7 1
pick -3.5 1
pick -3.5 2.2
pick -1.7 2.2
done

shape add
setwindow Form.mini
FORM mini class PACKAGE GEOMETRY
FORM mini subclass PLACE_BOUND_TOP
FORM mini dyns_fill_type Static solid
FORM mini dyns_grid None
FORM mini dyns_lock_mode Line
setwindow pcb
pick -3.87 -2.675
pick 3.87 -2.675
pick 3.87 2.675
pick -3.87 2.675
pick -3.87 -2.675
done

shape add
setwindow Form.mini
FORM mini class PACKAGE GEOMETRY
FORM mini subclass DFA_BOUND_TOP
FORM mini dyns_fill_type Static solid
FORM mini dyns_grid None
FORM mini dyns_lock_mode Line
setwindow pcb
pick -3.87 -2.675
pick 3.87 -2.675
pick 3.87 2.675
pick -3.87 2.675
pick -3.87 -2.675
done

add line
setwindow Form.mini
FORM mini lock_direction Off
FORM mini class PACKAGE GEOMETRY
FORM mini subclass SILKSCREEN_TOP
FORM mini line_width 0.15
setwindow pcb
pick -3.795 -2.55
pick -3.795 2.55
pick 3.795 2.55
pick 3.795 -2.55
pick -3.795 -2.55
done

add line
setwindow Form.mini
FORM mini lock_direction Off
FORM mini class PACKAGE GEOMETRY
FORM mini subclass ASSEMBLY_TOP
FORM mini line_width 0.12
setwindow pcb
pick -2.55 -2.475
pick -2.55 2.475
pick 2.55 2.475
pick 2.55 -2.475
pick -2.55 -2.475
done

add line
setwindow Form.mini
FORM mini lock_direction Off
FORM mini class PACKAGE GEOMETRY
FORM mini subclass DISPLAY_TOP
FORM mini line_width 0.025
setwindow pcb
pick -2.5 -2.425
pick -2.5 2.425
pick 2.5 2.425
pick 2.5 -2.425
pick -2.5 -2.425
done

add circle
setwindow Form.mini
FORM mini class PACKAGE GEOMETRY
FORM mini subclass SILKSCREEN_TOP
FORM mini line_width 0.25
setwindow pcb
pick -4.27 1.582
pick -4.145 1.582
done

add line
setwindow Form.mini
FORM mini lock_direction Off
FORM mini class PACKAGE GEOMETRY
FORM mini subclass PLACE_BOUND_TOP
FORM mini line_width 0.05
setwindow pcb
pick 0.35 0
pick -0.35 0
done

add line
setwindow Form.mini
FORM mini lock_direction Off
FORM mini class PACKAGE GEOMETRY
FORM mini subclass PLACE_BOUND_TOP
FORM mini line_width 0.05
setwindow pcb
pick 0 0.35
pick 0 -0.35
done

add circle
setwindow Form.mini
FORM mini class PACKAGE GEOMETRY
FORM mini subclass PLACE_BOUND_TOP
FORM mini line_width 0.05
setwindow pcb
pick 0 0
pick 0.25 0
done

unset addline_nomerge

# Attributes
setwindow pcb
package_height
pick grid 0 0
setwindow Form.mini
FORM mini height_max 1.6mm
setwindow pcb
done

define property
setwindow Form.dpr_select
FORM dpr_select name DESCRIPTION
setwindow Form.dpr_define
FORM dpr_define shapes_elem YES
FORM dpr_define symbols_elem YES
FORM dpr_define data_type STRING
FORM dpr_define apply
setwindow Form.dpr_select
FORM dpr_select done

property edit
setwindow Form.find
FORM find name_type Drawing
FORM find find_by_name
setwindow Form.findname
FORM findname objlist 'Drawing Select'
FORM findname done
setwindow Form.editprop1
FORM editprop1 properties Description
setwindow Form.editprop2
FORM editprop2 Description ele_prop_value "Integrated Circuit, Dual Flat No-Lead (DFN) 4 pins, 5.20 mm pitch; 5.00 mm L X 4.85 mm W X 1.60 mm H body"
setwindow Form.editprop1
FORM editprop1 done

# Labels
Label refdes
setwindow Form.mini
FORM mini text_block 6
FORM mini angle 0
FORM mini mirror NO
FORM mini text_justification Center
FORM mini class REF DES
FORM mini subclass ASSEMBLY_TOP
setwindow pcb
pick 0 -1
Text "REF"
done
setwindow pcb

Label refdes
setwindow Form.mini
FORM mini text_block 3
FORM mini angle 0
FORM mini mirror NO
FORM mini text_justification Center
FORM mini class REF DES
FORM mini subclass SILKSCREEN_TOP
setwindow pcb
pick 0 -0.6
Text "REF"
done
setwindow pcb

# 3D STEP Model Placement
setwindow pcb
generaledit
scriptmode +e
setwindow pcb
generaledit
3DX
setwindow PropPane
generaledit
QtSignal Allegro3DWindow Allegro3DWindow activate
QtSignal PropertyStatusWidget 3d_model_import clicked
QtFillin filesystem "SMD_5048_4P.step" "SMD_5048_4P.step"
updateport SearchPane
updateport PropPane
QtSignal algro3dGlobal algro3dDispatch flush
QtSignal Allegro3DWindow Allegro3DWindow deactivate
setwindow pcb

zoom fit
save
exit
# END
