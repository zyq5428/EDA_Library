# 操作系统、编辑器与 Python 临时文件
.DS_Store
Thumbs.db
Desktop.ini
__pycache__/
*.py[cod]
.venv/
.vscode/
.idea/

# Cadence 临时文件、锁与日志（正式 .olb/.dra/.psm/.pad 不忽略）
*.lck
*.lock
*.log
*.jrl
*.bak
*.tmp
*.dmp

# 本机配置和凭据不入库；共享路径配置见 docs
.env
.env.*
*.license

# 原始第三方资料默认只在本地暂存；确认许可后可有选择地添加
incoming/*
!incoming/README.md

# 已审核保留的原始导出日志是来源记录
!sources/export-logs/*
!projects/exports/**
